{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    {
      "source": "/((?!js(?:/|$)|css(?:/|$)|images(?:/|$)|fonts(?:/|$)).*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "{html/**,css/**,js/**,images/logo/**,images/sunergates-logo/**,admin/dist/**,images/product photo/**,images/home page photo/**,images/home-photo-beforemenu/**,images/collections-hero/**,images/4-epoxes-photo/**,fonts/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 4 * * *"
    }
  ]
}
