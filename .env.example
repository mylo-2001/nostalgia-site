# ============================================================
#  Nostalgia backend — environment configuration
#  Copy this file to ".env" and fill in the real values.
#  ".env" is git-ignored and must NEVER be committed.
# ============================================================

# ---- Server ----
PORT=8000
# Production: NODE_ENV=production ενεργοποιεί HTTPS redirect, HSTS, Secure cookies
NODE_ENV=development
# Μπροστά από reverse proxy (Vercel, nginx, Cloudflare) — απαραίτητο για σωστό HTTPS
TRUST_PROXY=true
# Επιπλέον allowed origins για API (κόμμα-διαχωρισμένα), πέρα από το SITE_URL
# ALLOWED_ORIGINS=https://www.yourdomain.com

# ---- PostgreSQL ----
# Production (Supabase, Neon, Railway, κ.λπ.):
# Βάλε μόνο το DATABASE_URL — έχει προτεραιότητα έναντι των PG*.
# Supabase → Project Settings → Database → Connection string (Shared Pooler)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Optional Supabase Read Replica connection string. Leave empty until you add a
# Read Replica in Supabase and copy its dedicated pooler connection string.
# Public read-heavy endpoints can use this; writes always stay on DATABASE_URL.
READ_DATABASE_URL=
# Πόσα ταυτόχρονα queries επιτρέπονται προς τη βάση (connection pool).
# Πρέπει να είναι ΚΑΤΩ από το όριο συνδέσεων του ίδιου του PostgreSQL server:
#   Supabase free tier → όριο ~15-20, άφησέ το κενό (default 10).
#   Δικός μας Postgres σε VPS → όριο 100, βάλε 20-25.
DB_POOL_MAX=
# Μετά από πόσα λεπτά μια ΑΠΛΗΡΩΤΗ παραγγελία με κάρτα ακυρώνεται και το
# απόθεμα επιστρέφει (μέσω /api/cron/maintenance). Default 120 = 2 ώρες.
# Αφορά ΜΟΝΟ κάρτα — αντικαταβολή/τραπεζική κατάθεση δεν αγγίζονται ποτέ.
PENDING_ORDER_TIMEOUT_MIN=120

# ---- Telegram ειδοποιήσεις (προαιρετικό) ----
# Δημιουργία bot: Telegram → @BotFather → /newbot → δίνει το token.
# Δύο ΞΕΧΩΡΙΣΤΑ chat id ώστε η ιδιοκτήτρια να βλέπει μόνο παραγγελίες και ο
# προγραμματιστής μόνο τεχνικά σφάλματα. Αν μείνουν κενά, δεν στέλνεται τίποτα.
TELEGRAM_BOT_TOKEN=
# Νέες παραγγελίες → η ιδιοκτήτρια του καταστήματος
TELEGRAM_CHAT_ORDERS=
# Τεχνικοί συναγερμοί (αρνητικό στοκ, checkout errors) → ο προγραμματιστής
TELEGRAM_CHAT_TECH=

# ---- Versioned database migrations ----
# Optional dedicated database URL. Falls back to DATABASE_URL / PG*.
MIGRATION_DATABASE_URL=
MIGRATION_SCHEMA=public
# Remote and production writes are blocked unless explicitly enabled.
ALLOW_REMOTE_MIGRATIONS=false
ALLOW_PRODUCTION_MIGRATIONS=false
# Down migrations additionally require this flag and --confirm-down.
ALLOW_DESTRUCTIVE_MIGRATIONS=false
# Integration tests refuse databases whose name does not contain "test".
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/

# ---- Traffic protection / read cache ----
RATE_LIMIT_PUBLIC_MAX=600
RATE_LIMIT_API_MAX=180
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_WINDOW_MS=60000
READ_CACHE_TTL_MS=20000

# Local dev (αν ΔΕΝ έχεις DATABASE_URL, χρησιμοποιούνται αυτά):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=

# ---- Session / auth secret ----
# Υπογράφει τα login cookies (HMAC). Το site ΔΕΝ χρησιμοποιεί NextAuth,
# αλλά δέχεται και NEXTAUTH_SECRET (συνηθισμένο σε hosting/Vercel).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NEXTAUTH_SECRET=
# HMAC capability for guest order status/returns. Use at least 32 random bytes.
GUEST_TOKEN_SECRET=

# ---- Admin panel credentials + secret UI path ----
# When ADMIN_PASSWORD is set here, it is the source of truth and is
# applied on every startup. Leave it empty to manage the password from
# the admin panel instead (a random one is generated on first run).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Secret URL for the React admin UI (NOT the JSON API at /api/admin).
# Use a long random path so /admin is not guessable. /admin always 404s.
# Example: /ni-ops-k7m2xq9p
# Generate: node -e "console.log('/'+require('crypto').randomBytes(9).toString('base64url'))"
ADMIN_UI_PATH=
# Keep true in production. Set false only for local development without 2FA.
ADMIN_2FA_REQUIRED=true
# Emergency-only escape hatch. Keep false in normal operation.
ALLOW_ADMIN_2FA_DISABLE=false

# ---- Stripe (card payments) ----
# Keys from the Stripe Dashboard → Developers → API keys.
# Secret key (sk_live_... or sk_test_...) — server only, never expose in frontend.
STRIPE_SECRET_KEY=
# Publishable key (pk_live_... or pk_test_...) — optional; Checkout redirect
# does not need it on the client, but keep it here for reference / future use.
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...) from Stripe Dashboard → Webhooks.
# Endpoint URL: https://yourdomain.com/api/stripe/webhook
# Events: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# V2 checkout stays off until migrations, inventory, shipping/tax rules,
# Stripe webhook and a frequent reservation-expiry scheduler are verified.
CHECKOUT_V2_ENABLED=false

# ---- Cloudflare Turnstile (CAPTCHA) — optional ----
# Protects login / register / admin-login from bots. Leave BOTH blank to
# disable entirely (the forms work normally without a CAPTCHA).
# Get keys free at: Cloudflare Dashboard → Turnstile → Add site.
#   TURNSTILE_SITE_KEY   → public, sent to the browser (0x4AAAAA...)
#   TURNSTILE_SECRET_KEY → server-side verification secret (0x4AAAAA...)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Cron / scheduled jobs ----
# Bearer token for protected /api/cron/* routes (Vercel Cron, GitHub Actions, etc.).
CRON_TOKEN=
# Vercel Cron sends this value as an Authorization Bearer token.
CRON_SECRET=

# ---- Encrypted database backups / restore drills ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
# Must be an isolated database whose name contains "restore_test".
RESTORE_TEST_DATABASE_URL=

# ---- Google Analytics ----
# Measurement ID from GA4 (format G-XXXXXXXXXX).
# NEXT_PUBLIC_ prefix is a Next.js convention; this site accepts either name.
GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Email (order confirmation receipts) ----
# Option A — Resend (https://resend.com/api-keys) — preferred if set.
RESEND_API_KEY=
# Order-only sender (confirmations, tracking links), e.g.
# "Nostalgia Collection <orders@yourdomain.com>"
EMAIL_FROM=
# Marketing sender (new product / sale / coupon broadcasts, welcome offer).
# Falls back to EMAIL_FROM if left blank.
EMAIL_FROM_MARKETING=
# Sender for password reset codes / account help, Reply-To on order and
# marketing emails above, and the recipient for the /contact form
# notification. Must be a real, monitored inbox.
SUPPORT_EMAIL=

# Option B — SMTP fallback (used when RESEND_API_KEY is empty). Use the real
# mailbox credentials from your mail host's control panel (host/port/user/
# pass), not a personal address. Most cPanel-style mail servers only let an
# authenticated mailbox send "From" itself, so each role gets its own login;
# SMTP_USER/SMTP_PASS below are a shared fallback for any role left unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER_ORDERS=
SMTP_PASS_ORDERS=
SMTP_USER_SUPPORT=
SMTP_PASS_SUPPORT=
SMTP_USER_MARKETING=
SMTP_PASS_MARKETING=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public base URL of the site — used in emails, sitemap, llms.txt, OG links.
# Production: ΠΡΕΠΕΙ να είναι https:// για κρυπτογράφηση & anti-MITM
SITE_URL=http://localhost:8000

# Shipping carrier name shown on the receipt. Leave blank until you choose one.
COURIER_NAME=

# ---- Cloudinary (product photos — CDN, not stored in PostgreSQL) ----
# https://console.cloudinary.com/app/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- ACS Courier REST API (ACSAutoRest) ----
# https://webservices.acscourier.net/ACSRestServices/api/ACSAutoRest
# ACS_API_KEY is issued directly by ACS (contact cs@acscourier.gr / your ACS
# account manager, mention your customer code) — separate from Company/User
# login below. Leave everything blank to keep ACS shipping features disabled.
ACS_API_KEY=
ACS_COMPANY_ID=
ACS_COMPANY_PASSWORD=
ACS_USER_ID=
ACS_USER_PASSWORD=
# "Επί πιστώσει" billing/customer code, e.g. 2ΑΘ999999 — used as Billing_Code.
ACS_BILLING_CODE=

# Announcement emails — "Επίσημα στοιχεία επικοινωνίας" block (admin → Ανακοινώσεις).
OFFICIAL_EMAILS=privacy@example.gr,partners@example.gr,info@example.gr
SHOP_PHONE=+30 000 000 0000
SHOP_CITY=Θεσσαλονίκη
# Bulk send pacing — providers rate-limit; raise the pause if you see failures.
EMAIL_BATCH_SIZE=10
EMAIL_BATCH_PAUSE_MS=1100

# Delivery window shown on the order confirmation (business days, weekends skipped).
DELIVERY_MIN_DAYS=2
DELIVERY_MAX_DAYS=5

# ---------- GDPR data retention (server/services/retention-service.js) ----------
# Everything below is a DRY RUN until RETENTION_ENABLED=true. Run the sweep,
# read what it reports, and only then switch it on — deletion is irreversible.
RETENTION_ENABLED=false
# Contact-form enquiries.
RETENTION_MESSAGES_MONTHS=24
# Audit trails (audit_log / audit_logs).
RETENTION_AUDIT_MONTHS=12
# Admin login attempts and session history.
RETENTION_ADMIN_EVENTS_MONTHS=6
# Per-recipient delivery log for announcements/campaigns.
RETENTION_CAMPAIGN_MONTHS=12
# Orders: the customer identity is stripped after this many years; the order
# itself (amounts, number, dates) is KEPT for tax purposes. Six clears the
# Greek five-year requirement with a margin.
RETENTION_ORDER_ANONYMISE_YEARS=6
