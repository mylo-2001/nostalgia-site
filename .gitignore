# Dependencies
node_modules/

# Local database / generated server data
server/data/

# Secrets - never commit. Use .env.example as the template.
.env
.env.*
!.env.example

# Vercel local project metadata
.vercel/

# Local agent/tool caches
.agents/
.claude/
.pdf_tools/
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated database backups
backups/
*.dump
*.dump.enc
*.partial

# Test and tool cache output
coverage/
.nyc_output/
.cache/
.tmp/
tmp/

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# React admin build + deps
admin/node_modules/
admin/dist/

.vercel
.env*

# Generated ACS labels — real sender address, phone and voucher barcodes.
acs-test/
acs-test-pdf/
*voucher*.pdf
*lista-paralavis*.pdf

# Internal notes and supplier paperwork. THIS REPO IS PUBLIC on GitHub, so
# anything here would be world-readable — these hold the ΑΦΜ, the ACS billing
# code and username, and a full description of our security posture.
deploy/website/
new/
MARKETING-SETUP.md
WORLDLINE-SETUP.md
ACS-SETUP.md

# Contact-form attachments uploaded by customers. server.js keeps these out of
# the public *static* tree, which is not the same as keeping them out of *git* —
# a single `git add -A` would publish other people's files to a public repo.
.private/

# Supplier DPAs and compliance paperwork. Signed copies carry the ΑΦΜ, the
# registered address and account identifiers, so every document here stays out
# of this public repo. Only the README travels with the code — it explains what
# belongs in the folder without containing any of it. Ignoring the contents
# rather than the directory is deliberate: `compliance/` on its own would stop
# git descending into the folder and the negation below would never apply.
compliance/*
!compliance/README.md

# The rest of deploy/ (nginx conf, systemd unit, crontab, cron scripts) stays
# tracked on purpose: it is infrastructure-as-code the server needs on clone,
# and it holds no secrets — every script reads them from .env at runtime.

# Google OAuth client files. The JSON that Google hands you on creation carries
# the client_secret in plain text, and it lands in the project root with a name
# nobody thinks to check. THIS REPO IS PUBLIC — one `git add -A` would publish
# the credential. Keys belong in .env, which is already ignored.
client_secret_*.json
*client_secret*.json
