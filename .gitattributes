# Line endings.
#
# core.autocrlf=true on this machine rewrites checked-out files to CRLF, which
# is fine for Windows editing but fatal for anything Linux executes: a shell
# script stored with CRLF fails on the VPS with
#   /usr/bin/env: 'bash\r': No such file or directory
# and a systemd unit or crontab with CRLF is silently mis-parsed.
#
# Force LF for everything the server runs or reads.
* text=auto

*.sh            text eol=lf
*.crontab       text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Binary assets — never touch these.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.gif           binary
*.mp4           binary
*.woff          binary
*.woff2         binary
*.pdf           binary
*.ico           binary
